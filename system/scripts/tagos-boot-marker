#!/bin/sh
# Wait until a TagOS desktop session reports readiness, then print a marker on
# the serial console and run the post-boot checks. tools/run-qemu.sh --boot-test
# and the CI boot job grep the serial log for TAGOS_BOOT_OK.
#
# The readiness file is written by tag-shell itself (see tag-shell.service), so
# this is a real end-to-end check: compositor up, D-Bus up, shell rendering.
set -u

DEADLINE=${TAGOS_BOOT_TIMEOUT:-180}
SERIAL=/dev/ttyS0

emit() {
    printf '%s\n' "$1" >"$SERIAL" 2>/dev/null || true
    printf '%s\n' "$1"
}

# Runs a command as the logged-in desktop user with the session environment, so
# applications reach the compositor instead of failing on a missing socket.
as_user() {
    uid=$(id -u tagos 2>/dev/null) || return 1
    [ -n "$uid" ] || return 1
    runtime="/run/user/$uid"
    [ -d "$runtime" ] || return 1
    setpriv --reuid="$uid" --regid="$(id -g tagos)" --init-groups \
        env -i HOME=/home/tagos USER=tagos LOGNAME=tagos \
            XDG_RUNTIME_DIR="$runtime" XDG_SESSION_TYPE=wayland \
            WAYLAND_DISPLAY=wayland-0 PATH=/usr/local/bin:/usr/bin:/bin \
            "$@" >/dev/null 2>&1
}

# Launching a real application proves more than checking a binary exists: it
# exercises the Wayland socket, the QML import path and the .desktop entry.
launch_check() {
    name="$1"
    if ! command -v "$name" >/dev/null 2>&1; then
        emit "TAGOS_CHECK $name=missing"
        return
    fi
    as_user "$name" &
    child=$!
    waited=0
    while [ "$waited" -lt 25 ]; do
        if pgrep -x "$name" >/dev/null 2>&1; then
            emit "TAGOS_CHECK $name=launched"
            # Leave the app running: seeing it on the VT is part of the test.
            return
        fi
        sleep 1
        waited=$((waited + 1))
    done
    emit "TAGOS_CHECK $name=launch-failed"
    kill "$child" 2>/dev/null || true
}

emit "TAGOS_BOOT_WAITING timeout=${DEADLINE}s"

elapsed=0
ready_file=""
while [ "$elapsed" -lt "$DEADLINE" ]; do
    for ready in /run/user/*/tagos/ready; do
        if [ -f "$ready" ]; then
            ready_file="$ready"
            break
        fi
    done
    [ -n "$ready_file" ] && break
    sleep 1
    elapsed=$((elapsed + 1))
done

if [ -z "$ready_file" ]; then
    emit "TAGOS_BOOT_TIMEOUT after ${DEADLINE}s"
    # Non-zero so the failure is visible in `systemctl status` inside the VM too.
    exit 1
fi

emit "TAGOS_BOOT_OK session=$(cat "$ready_file" 2>/dev/null || echo unknown)"

# Post-boot application checks. Each one prints a single TAGOS_CHECK line so the
# CI job can assert on them without a screenshot.
if pgrep -x tag-shell >/dev/null 2>&1; then
    emit "TAGOS_CHECK tag-shell=running"
else
    emit "TAGOS_CHECK tag-shell=missing"
fi
# Reporting the *state* of the user unit, not just its absence, means a failing
# service explains itself in the boot log instead of needing another build with a
# diagnostic unit bolted on.
user_unit_state() {
    uid=$(id -u tagos 2>/dev/null) || { echo unknown; return; }
    runtime="/run/user/$uid"
    [ -d "$runtime" ] || { echo no-runtime-dir; return; }
    setpriv --reuid="$uid" --regid="$(id -g tagos)" --init-groups         env -i HOME=/home/tagos XDG_RUNTIME_DIR="$runtime" PATH=/usr/local/bin:/usr/bin:/bin         systemctl --user is-active "$1" 2>/dev/null | head -1
}

if pgrep -x tag-flowd >/dev/null 2>&1; then
    emit "TAGOS_CHECK tag-flowd=running"
else
    state=$(user_unit_state tag-flow.service)
    detail=$(journalctl -t tag-flowd -n 1 -o cat 2>/dev/null | head -1)
    emit "TAGOS_CHECK tag-flowd=missing state=${state:-unknown} log=${detail:-none}"
fi

launch_check tag-files
launch_check firefox

# The browser needs a real package; report presence separately from launching so
# a missing browser is distinguishable from a Wayland problem.
if command -v firefox >/dev/null 2>&1; then
    emit "TAGOS_CHECK firefox-package=installed $(firefox --version 2>/dev/null | head -1)"
else
    emit "TAGOS_CHECK firefox-package=missing"
fi

emit "TAGOS_SELFTEST_DONE"
exit 0
