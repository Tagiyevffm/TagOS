[Unit]
Description=Emit the TagOS boot-ready marker on the serial console (live media / CI)
Documentation=https://github.com/tagos/tagos
# Only useful on images booted in QEMU with a serial console attached.
ConditionPathExists=/dev/ttyS0
After=greetd.service

[Service]
Type=oneshot
# Booting an ISO under TCG can take several minutes before the shell is up.
Environment=TAGOS_BOOT_TIMEOUT=600
RemainAfterExit=yes
ExecStart=/usr/lib/tagos/tagos-boot-marker
StandardOutput=journal
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
