[Unit]
Description=TagOS system metrics service (org.tagos.Flow1)
Documentation=https://github.com/tagos/tagos
PartOf=tag-session.target
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/tag-flowd --interval 1500
Restart=on-failure
RestartSec=2s
# A metrics reader needs no privileges at all.
NoNewPrivileges=yes
# No PrivateTmp: the session bus is started by dbus-run-session in tag-session and
# its socket lives in a private tmp directory, which is exactly what a private /tmp
# hides. With it the daemon only ever reported 'session bus unavailable'.
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=tag-session.target
