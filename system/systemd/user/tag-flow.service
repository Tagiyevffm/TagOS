[Unit]
Description=TagOS system metrics service (org.tagos.Flow1)
Documentation=https://github.com/tagos/tagos
PartOf=tag-session.target
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
# dbus.socket is started with the session, but the user manager does not export
# its address, so tag-flowd reported 'session bus unavailable' and exited. The
# address is the standard socket-activated one.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/bin/tag-flowd --interval 1500
Restart=on-failure
RestartSec=2s
# A metrics reader needs no privileges at all.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=tag-session.target
