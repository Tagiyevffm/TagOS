#!/bin/sh
# tag-session — start a TagOS user session.
#
# greetd (or a TTY login) calls this as the session command. Responsibilities for
# Phase 0 are deliberately small and observable:
#   1. export a deterministic environment for Wayland/Qt clients,
#   2. make sure the user D-Bus session and systemd user manager are alive,
#   3. hand the session over to labwc (the compositor never forks away),
#   4. bring up TagOS' own user services (tag-flow, tagshell).
#
# Everything the compositor or shell needs afterwards is a systemd user unit in
# /usr/lib/systemd/user, so a crashed shell is restarted by systemd and not by
# this script.
set -eu

: "${XDG_CURRENT_DESKTOP:=TagOS}"
: "${XDG_SESSION_DESKTOP:=TagOS}"
# greetd starts the session from a VT and PAM exports XDG_SESSION_TYPE=tty, so this
# must be forced rather than defaulted: a Wayland session that claims to be tty
# makes every client look for a text renderer.
XDG_SESSION_TYPE=wayland
: "${QT_QPA_PLATFORM:=wayland}"
: "${QT_WAYLAND_DISABLE_WINDOWDECORATION:=1}"
: "${MOZ_ENABLE_WAYLAND:=1}"
: "${ELECTRON_OZONE_PLATFORM_HINT:=auto}"
export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
export QT_QPA_PLATFORM QT_WAYLAND_DISABLE_WINDOWDECORATION MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT

# greetd swallows the session command's stderr, so on a headless boot a failing
# session leaves no evidence at all. The log is therefore also written to a file
# (overridable; set TAGOS_SESSION_LOG to an empty value to disable it).
: "${TAGOS_SESSION_LOG:=/tmp/tagos-session.log}"

log() {
    printf 'tag-session: %s\n' "$*" >&2
    if [ -n "$TAGOS_SESSION_LOG" ]; then
        printf 'tag-session: %s\n' "$*" >>"$TAGOS_SESSION_LOG" 2>/dev/null || true
    fi
}

log "session start: user=$(id -un) uid=$(id -u) wayland=${WAYLAND_DISPLAY:-unset} runtime=${XDG_RUNTIME_DIR:-unset}"

if [ ! -x "$(command -v labwc 2>/dev/null || true)" ]; then
    log "labwc is not installed; cannot start the TagOS session"
    exit 127
fi

# The live medium boots in VMs (QEMU TCG, no virgl), where wlroots cannot get an
# EGL surface from virtio-gpu and exits before the shell can start. The software
# renderer works everywhere; installed systems keep the default GPU path.
if [ -e /etc/archiso-live ] && [ -z "${WLR_RENDERER:-}" ]; then
    WLR_RENDERER=pixman
    export WLR_RENDERER
    log "live medium: using the pixman renderer"
fi

# Publish the session environment to systemd --user and D-Bus activation so that
# units started later inherit WAYLAND_DISPLAY and friends.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP \
        XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORM 2>/dev/null || true
fi

log "starting session: Type=${XDG_SESSION_TYPE} Desktop=${XDG_SESSION_DESKTOP}"

# labwc runs the autostart file from /etc/xdg/labwc/autostart, which is what
# starts tagos-session.target (tag-flow + tagshell) in Phase 0.
# The compositor's own stderr is the only place a failed backend explains itself,
# and greetd does not forward it, so it is mirrored into the session log.
if [ -n "$TAGOS_SESSION_LOG" ]; then
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
        dbus-run-session -- labwc "$@" 2>&1 | tee -a "$TAGOS_SESSION_LOG"
    else
        labwc "$@" 2>&1 | tee -a "$TAGOS_SESSION_LOG"
    fi
    exit 0
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- labwc "$@"
fi
exec labwc "$@"
